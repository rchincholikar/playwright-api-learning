{
  "name": "playwright-api-learning",
  "version": "1.0.0",
  "description": "Learning Playwright API testing with TypeScript",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:headed": "playwright test --headed",
    "typecheck": "tsc",
    "report": "playwright show-report"
  },
  "keywords": [
    "playwright",
    "api-testing",
    "typescript"
  ],
  "author": "rchincholikar",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  }
}
